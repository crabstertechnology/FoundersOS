
{
  "entities": {
    "CompanyProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CompanyProfile",
      "type": "object",
      "description": "Represents a startup company's core information and share-based cap table summary.",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "totalSharesOutstanding": { "type": "number", "description": "Total count of all issued shares." },
        "latestValuation": { "type": "number", "description": "Post-money valuation of the most recent round in INR." },
        "stage": { "type": "string" },
        "industry": { "type": "string" },
        "monthlyRevenue": { "type": "number" },
        "monthlyBurnRate": { "type": "number" },
        "cashInBank": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyName", "totalSharesOutstanding", "latestValuation"]
    },
    "FundingRound": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FundingRound",
      "type": "object",
      "description": "History of an investment round.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "roundName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "amountRaised": { "type": "number" },
        "preMoneyValuation": { "type": "number" },
        "postMoneyValuation": { "type": "number" },
        "sharesIssued": { "type": "number" },
        "pricePerShare": { "type": "number" }
      },
      "required": ["id", "companyId", "roundName", "amountRaised", "preMoneyValuation"]
    },
    "Shareholder": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Shareholder",
      "type": "object",
      "description": "Represents an owner of company shares.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["Founder", "Investor", "ESOP", "Advisor"] },
        "shareClass": { "type": "string", "enum": ["Common", "Preferred", "SAFE"] },
        "sharesOwned": { "type": "number" },
        "amountInvested": { "type": "number" },
        "investmentDate": { "type": "string", "format": "date" },
        "vestingStart": { "type": "string", "format": "date" },
        "vestingCliffMonths": { "type": "number" },
        "vestingDurationMonths": { "type": "number" }
      },
      "required": ["id", "companyId", "name", "role", "shareClass", "sharesOwned"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}/companyProfiles/{companyId}": {
      "schema": "#/backend/entities/CompanyProfile",
      "description": "Core company data."
    },
    "/users/{userId}/companyProfiles/{companyId}/fundingRounds/{roundId}": {
      "schema": "#/backend/entities/FundingRound",
      "description": "Historical funding events."
    },
    "/users/{userId}/companyProfiles/{companyId}/shareholders/{shareholderId}": {
      "schema": "#/backend/entities/Shareholder",
      "description": "Cap table registry."
    }
  }
}
