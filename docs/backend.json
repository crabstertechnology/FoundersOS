
{
  "entities": {
    "CompanyProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CompanyProfile",
      "type": "object",
      "description": "Represents a startup company's core information and equity summary.",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "latestValuation": { "type": "number", "description": "Post-money valuation in INR." },
        "stage": { "type": "string" },
        "industry": { "type": "string" },
        "monthlyRevenue": { "type": "number" },
        "monthlyBurnRate": { "type": "number" },
        "cashInBank": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyName", "latestValuation"]
    },
    "FundingRound": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FundingRound",
      "type": "object",
      "description": "History of an investment or partnership round.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "roundName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "amountRaised": { "type": "number" },
        "preMoneyValuation": { "type": "number" },
        "postMoneyValuation": { "type": "number" },
        "equityOffered": { "type": "number", "description": "Percentage of equity granted in this round." }
      },
      "required": ["id", "companyId", "roundName", "amountRaised", "equityOffered"]
    },
    "Shareholder": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Shareholder",
      "type": "object",
      "description": "Represents an owner of company equity.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["Founder", "Investor", "ESOP", "Advisor", "Partner"] },
        "ownershipPercentage": { "type": "number" },
        "investmentDate": { "type": "string", "format": "date" }
      },
      "required": ["id", "companyId", "name", "role", "ownershipPercentage"]
    },
    "StrategicReport": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "StrategicReport",
      "type": "object",
      "description": "An AI-generated strategic advice report.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "inputSnapshot": { "type": "object", "description": "The data used to generate this report." },
        "advice": { 
          "type": "object",
          "properties": {
            "summary": { "type": "string" },
            "strengths": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } },
            "recommendations": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "required": ["id", "companyId", "createdAt", "advice"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}/companyProfiles/{companyId}": {
      "schema": "#/backend/entities/CompanyProfile",
      "description": "Core company data."
    },
    "/users/{userId}/companyProfiles/{companyId}/fundingRounds/{roundId}": {
      "schema": "#/backend/entities/FundingRound",
      "description": "Historical funding events."
    },
    "/users/{userId}/companyProfiles/{companyId}/shareholders/{shareholderId}": {
      "schema": "#/backend/entities/Shareholder",
      "description": "Cap table registry."
    },
    "/users/{userId}/companyProfiles/{companyId}/strategicReports/{reportId}": {
      "schema": "#/backend/entities/StrategicReport",
      "description": "Historical strategic reports."
    }
  }
}
