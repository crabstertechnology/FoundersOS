rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isEmployeeOrManager(userId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.adminUid == userId;
    }

    function hasReadAccess(userId) {
      return isUser(userId) || isEmployeeOrManager(userId);
    }

    function hasWriteAccess(userId) {
      return isUser(userId) || (
        isEmployeeOrManager(userId) && (
          get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == 'Manager' ||
          get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == 'manager' ||
          get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == 'MANAGER' ||
          get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == 'Admin' ||
          get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == 'ADMIN'
        )
      );
    }

    match /users/{userId} {
      allow get: if hasReadAccess(userId);
      allow create, update, delete: if isUser(userId);
      allow list: if false;

      match /companyProfiles/{companyId} {
        allow read: if hasReadAccess(userId);
        allow write: if hasWriteAccess(userId);

        match /fundingRounds/{roundId} {
          allow read: if hasReadAccess(userId);
          allow write: if hasWriteAccess(userId);
        }

        match /shareholders/{shareholderId} {
          allow read: if hasReadAccess(userId);
          allow write: if hasWriteAccess(userId);
        }

        match /strategicReports/{reportId} {
          allow read: if hasReadAccess(userId);
          allow create, delete: if hasWriteAccess(userId);
          allow update: if false;
        }

        match /chats/{chatId} {
          allow read: if hasReadAccess(userId);
          allow write: if hasWriteAccess(userId);
        }

        match /tasks/{taskId} {
          allow read: if hasReadAccess(userId);
          allow write: if hasWriteAccess(userId);
          allow read: if isSignedIn() && resource.data.assignedToUid == request.auth.uid;
          allow update: if isSignedIn()
            && resource.data.assignedToUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']);
        }

        match /teamChats/{messageId} {
          allow read, write: if isUser(userId);
          allow read, create: if isSignedIn() &&
            exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.adminUid == userId;
          // Allow sender to fully edit/delete their own messages
          allow update, delete: if isSignedIn() &&
            resource.data.senderUid == request.auth.uid;
          // Allow any team member to mark messages as read (update readBy only)
          allow update: if isSignedIn() &&
            exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.adminUid == userId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        }

        match /presence/{presenceId} {
          allow read: if hasReadAccess(userId);
          allow write: if isSignedIn();
        }

        match /directMessages/{dmChannelId}/messages/{messageId} {
          // Admin (userId) can always read/write all DMs in their company
          allow read, write: if isUser(userId);
          // Employees can access DMs where their UID appears in the channel ID
          // channelId format: "uid1_uid2" (sorted). Firebase UIDs have no underscores so this is safe.
          allow read, write: if isSignedIn() &&
            isEmployeeOrManager(userId) &&
            (dmChannelId.matches('^' + request.auth.uid + '_.*') ||
             dmChannelId.matches('.*_' + request.auth.uid + '$'));
        }
      }
    }

    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == employeeId;
      allow update: if isSignedIn() && (
        (resource.data.adminUid == request.auth.uid) ||
        (request.auth.uid == employeeId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'adminUid', 'companyProfileId', 'isActive']))
      );
      allow delete: if isSignedIn() && resource.data.adminUid == request.auth.uid;
      allow list: if isSignedIn();
    }

    match /inviteCodes/{code} {
      allow get: if true;
      allow create: if isSignedIn() && request.resource.data.adminUid == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.adminUid == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt']) && request.resource.data.used == true)
      );
      allow delete: if isSignedIn() && resource.data.adminUid == request.auth.uid;
      allow list: if isSignedIn();
    }

    match /calendarMeetings/{meetingId} {
      allow read, update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }
  }
}