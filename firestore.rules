
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset enforces a strict user-ownership model where all data is private to the
     * authenticated user who created it.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update, delete: if isExistingOwner(userId);

      match /companyProfiles/{companyProfileId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.id == companyProfileId;
        allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
        allow delete: if isExistingOwner(userId);

        match /fundingRounds/{roundId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && request.resource.data.companyId == companyProfileId;
          allow update: if isExistingOwner(userId) && request.resource.data.companyId == resource.data.companyId;
          allow delete: if isExistingOwner(userId);
        }

        match /shareholders/{shareholderId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && request.resource.data.companyId == companyProfileId;
          allow update: if isExistingOwner(userId) && request.resource.data.companyId == resource.data.companyId;
          allow delete: if isExistingOwner(userId);
        }

        match /strategicReports/{reportId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && request.resource.data.companyId == companyProfileId;
          allow delete: if isExistingOwner(userId);
          // Reports are generally immutable once generated
          allow update: if false;
        }
      }
    }
  }
}
