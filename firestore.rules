rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset enforces a strict user-ownership model. All data under a user's
     * path is accessible only by that specific authenticated user.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // Allow a user to read/write their own user document
      allow get, create, update, delete: if isUser(userId);
      allow list: if false; // Users cannot list other users

      // All company-related data is nested under the user
      match /companyProfiles/{companyId} {
        allow read, write: if isUser(userId);

        match /fundingRounds/{roundId} {
          allow read, write: if isUser(userId);
        }

        match /shareholders/{shareholderId} {
          allow read, write: if isUser(userId);
        }

        match /strategicReports/{reportId} {
          allow read, create, delete: if isUser(userId);
          // Strategic reports are historically immutable
          allow update: if false;
        }

        match /chats/{chatId} {
          allow read, write: if isUser(userId);
        }
      }
    }
  }
}